# Neon pooled connection for the running application.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Neon direct connection for Prisma migrations and other CLI operations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
# Enable for local production-mode testing or when self-hosted behind a trusted proxy.
AUTH_TRUST_HOST="true"
DEMO_PASSWORD="MyaiguruDemo2026!"
# Server-side credentials for an OpenAI-compatible chat completions API.
AI_API_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="replace-with-your-api-key"
AI_API_MODEL="openai/gpt-oss-20b"
